{% extends 'base.html.twig' %}

{% block title %}Réinitialiser mon mot de passe{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-6">
        <h1 class="mb-4 text-center">Nouveau mot de passe</h1>

        {{ form_start(resetForm) }}
            {{ form_row(resetForm.plainPassword.first, {'label': 'Nouveau mot de passe'}) }}
            {{ form_row(resetForm.plainPassword.second, {'label': 'Confirmer le mot de passe'}) }}
            <button class="btn btn-primary w-100 mt-3" type="submit">Réinitialiser le mot de passe</button>
        {{ form_end(resetForm) }}
    </div>
</div>
{% endblock %}