{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié ?{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-6">
        <h1 class="mb-4 text-center">Mot de passe oublié ?</h1>
        <p>Entrez votre adresse email. Un lien de réinitialisation valable 5 heures vous sera envoyé.</p>

        {{ form_start(requestForm) }}
            {{ form_row(requestForm.email) }}
            <button class="btn btn-primary w-100 mt-3" type="submit">Envoyer</button>
        {{ form_end(requestForm) }}
    </div>
</div>
{% endblock %}