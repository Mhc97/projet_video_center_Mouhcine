<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Video Center{% endblock %}</title>
        
        {# ✅ Bootstrap CSS via CDN #}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
        
        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        <!-- NAVBAR -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" href="{{ path('app_home', {'_locale': app.request.locale}) }}">🎬 Video Center</a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_home', {'_locale': app.request.locale}) }}">{{ 'Accueil'|trans }}</a>
                        </li>
                        {% if app.user and app.user.isVerified %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_video_create', {'_locale': app.request.locale}) }}">{{ 'Ajouter une vidéo'|trans }}</a>
                            </li>
                        {% endif %}
                    </ul>

                    <ul class="navbar-nav">
                        {# 🌐 SWITCHER DE LANGUE #}
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                {% if app.request.locale == 'en' %}
                                    🇬🇧 English
                                {% else %}
                                    🇫🇷 Français
                                {% endif %}
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" href="{{ path(app.current_route, app.current_route_params|merge({'_locale': 'fr'})) }}">
                                        🇫🇷 Français
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="{{ path(app.current_route, app.current_route_params|merge({'_locale': 'en'})) }}">
                                        🇬🇧 English
                                    </a>
                                </li>
                            </ul>
                        </li>
                        
                        {# 👤 UTILISATEUR #}
                        {% if app.user %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_profile', {'_locale': app.request.locale}) }}">
                                    <i class="bi bi-person-circle"></i> {{ app.user.firstname }}
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_logout', {'_locale': app.request.locale}) }}">{{ 'Déconnexion'|trans }}</a>
                            </li>
                        {% else %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_login', {'_locale': app.request.locale}) }}">{{ 'Connexion'|trans }}</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_register', {'_locale': app.request.locale}) }}">{{ 'Inscription'|trans }}</a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>

        <!-- CONTENU -->
        <main class="container mt-4">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}
            {% endfor %}
            {% block body %}{% endblock %}
        </main>

        <!-- FOOTER -->
        <footer class="bg-dark text-white text-center py-3 mt-5">
            <div class="container">
                <p class="mb-0">&copy; {{ "now"|date("Y") }} Video Center - Tous droits réservés</p>
            </div>
        </footer>

        {# ✅ Bootstrap JS via CDN #}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        {% block javascripts %}{% endblock %}
    </body>
</html>