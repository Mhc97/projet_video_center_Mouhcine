{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="row justify-content-center">
    <div class="col-md-6">
        <h1 class="mb-4 text-center">Mon profil</h1>
        <ul class="list-group mb-4">
            <li class="list-group-item"><strong>Email :</strong> {{ user.email }}</li>
            <li class="list-group-item"><strong>Prénom :</strong> {{ user.firstname }}</li>
            <li class="list-group-item"><strong>Nom :</strong> {{ user.lastname }}</li>
            <li class="list-group-item"><strong>Compte créé le :</strong> {{ user.createdAt|date('d/m/Y H:i') }}</li>
        </ul>
    </div>
</div>
{% endblock %}
