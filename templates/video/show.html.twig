{% extends 'base.html.twig' %}
{% block title %}{{ video.title }}{% endblock%}
{% block body %}
<div class="row justify-content-center">
    <div class="col-md-8">
        {# 🔒 Vérification vidéo premium #}
        {% if video.premiumVideo and not (app.user and app.user.isVerified) %}
            <div class="alert alert-danger text-center">
                <h4>⛔ Accès restreint</h4>
                <p>Cette vidéo est réservée aux utilisateurs vérifiés.</p>
                {% if app.user %}
                    <a href="{{ path('app_profile') }}" class="btn btn-warning">Vérifier mon compte</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn btn-primary">Se connecter</a>
                {% endif %}
                <a href="{{ path('app_home') }}" class="btn btn-secondary">Retour</a>
            </div>
        {% else %}
            {# AFFICHAGE NORMAL #}
            <h1>{{ video.title }}</h1>
            <iframe width="100%" height="480" src="https://www.youtube.com/embed/{{ video.videoLink|youtube_id }}" frameborder="0" allowfullscreen></iframe>
            <p>{{ video.description }}</p>
            <small>Publiée le {{ video.createdAt|date('d/m/Y H:i') }}</small>
            <div class="mt-3">
                <a href="{{ path('app_home')}}" class="btn btn-secondary">Retour</a>
                
                {# 🔒 BOUTONS : Uniquement si propriétaire #}
                {% if app.user and video.user.id == app.user.id %}
                    <a href="{{ path('app_video_edit', {'id': video.id}) }}" class="btn btn-primary">Modifier</a>
                    <form method="post" action="{{ path('app_video_delete', {'id': video.id}) }}" style="display:inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ video.id) }}">
                        <button class="btn btn-danger" onclick="return confirm('Supprimer ?')">Supprimer</button>
                    </form>
                {% endif %}
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
