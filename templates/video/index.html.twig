{% extends 'base.html.twig' %}

{% block title %}Liste des vidéos{% endblock %}

{% block body %}
<h1 class="mb-4">Toutes les vidéos</h1>

<div class="row">
    {% for video in videos %}
        {% if not video.premiumVideo or (app.user and app.user.isVerified)%}
        <div class="col-md-4 mb-4">
            <div class="card">
                <div class="card-body">
                    <iframe 
                        width="300" 
                        height="200" 
                        src="https://www.youtube.com/embed/{{ video.videoLink|split('watch?v=')[1]|split('&')[0] }}" 
                        frameborder="0" 
                        allowfullscreen>
                    </iframe>
                    <h5 class="card-title mt-2">
                        <a href="{{ path('app_video_show', {'id': video.id}) }}">
                            {{ video.title|length > 20 ? video.title|slice(0, 20) ~ '...' : video.title }}
                        </a>
                    </h5>
                    <p class="card-text">
                        {{ video.description|length > 25 ? video.description|slice(0, 25) ~ '...' : video.description }}
                    </p>
                    <small class="text-muted">Publiée le {{ video.createdAt|date('d/m/Y H:i') }}</small>
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-12">
            <p>Aucune vidéo disponible.</p>
        </div>
        {% endif %}
    {% endfor %}
</div>
{% endblock %}
