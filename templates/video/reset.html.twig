{% extends 'base.html.twig' %}
{% block title %}Nouveau mot de passe{% endblock %}
{% block body %}
<div class="row justify-content-center">
    <div class="col-md-6">
        <h1 class="mb-4 text-center">Choisissez un nouveau mot de passe</h1>
        {{ form_start(resetForm) }}
            {{ form_row(resetForm.plainPassword.first) }}
            {{ form_row(resetForm.plainPassword.second) }}
            <button class="btn btn-primary w-100 mt-3" type="submit">Réinitialiser</button>
        {{ form_end(resetForm) }}
    </div>
</div>
{% endblock %}